# Multi-Agent AI Platform — environment variables.
#
# Every setting is optional for local development (app.config.Settings has
# a working default for all of them) — this file exists for reference and
# for hosted (Railway) deployment, not because local dev requires a .env.
# All variables use the MAP_ prefix (app.config.Settings, env_prefix="MAP_").
#
# Never commit a real .env file (already in .gitignore) and never commit
# real values of anything marked SECRET below.

# ---------------------------------------------------------------------------
# Local development — everything below this line is unset by default and
# does not need to be set for `uvicorn app.main:app --reload` / `python -m
# app.worker` to work.
# ---------------------------------------------------------------------------

# MAP_LOG_LEVEL=INFO
# MAP_WORKER_CONCURRENCY=1          # 1-4, also the `--concurrency` CLI flag

# ---------------------------------------------------------------------------
# Hosted deployment (Railway staging) — MA7.7B. See
# docs/deployment/railway-staging.md for the full runbook this file is a
# companion reference to.
# ---------------------------------------------------------------------------

# Opt-in switch for every hosted-only code path (app.config.Settings.
# hosted_mode): container-safe secret storage, no token injected into the
# unauthenticated "/" response, no printed/persisted token file,
# /docs+/openapi.json disabled. Required for a Railway deployment; leave
# unset for local development.
MAP_HOSTED_MODE=true

# SECRET. The hosted front-door bearer token (replaces the locally
# generated data/local_auth_token file, which a container has no
# interactive console to read on first run). >=32 characters, required
# when MAP_HOSTED_MODE=true. Generate with, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set this as a Railway *service variable* (or a Railway-generated
# secret), never a value in this file or in source control.
MAP_AUTH_TOKEN=

# SECRET. The Fernet key app.secrets_store.EncryptedFileSecretStore uses
# to encrypt provider API keys (e.g. the OpenRouter key) at rest on the
# persistent volume -- the hosted replacement for the OS keychain
# KeyringSecretStore depends on locally, which does not exist inside a
# container. Required when MAP_HOSTED_MODE=true. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every stored provider secret unrecoverable (by
# design -- there is no backdoor); re-enter the provider's API key via the
# API/console after rotating it.
MAP_SECRET_ENCRYPTION_KEY=

# Rebases every data_dir-derived path (database, artifacts, logs,
# workspaces, backups, the (unused-in-hosted-mode) local token file, the
# encrypted secrets file) onto the Railway volume's mount path in one
# step. Set this to exactly the volume's configured mount path -- once
# set, do not change it later: every artifacts.storage_ref row in the
# database is an absolute path baked in at write time (see MA7.7A finding
# #2), so moving the mount path orphans every existing artifact.
MAP_DATA_ROOT=/data

# Railway containers are not on loopback -- binding to 127.0.0.1 (the
# local-first default) would make the service unreachable. Both of these
# are required together (app.config.Settings._reject_unexplained_remote_bind
# refuses to start otherwise) -- this app is local-first by default and
# this is the explicit, intentional opt-out for a hosted deployment.
MAP_HOST=0.0.0.0
MAP_ALLOW_REMOTE_BIND=true

# Logged only (app_starting log line) -- does not change any behavior.
MAP_ENVIRONMENT=staging

# Console/file logging both go to stdout/Railway's log aggregator in a
# container; a rotating on-disk log file adds nothing hosted and just
# uses volume space.
MAP_LOG_TO_FILE=false

# 1-4. How many Agent Runs the single Worker process (started by
# scripts/hosted_entrypoint.py alongside the Web process) executes
# concurrently. See docs/deployment/railway-staging.md for sizing
# guidance -- SQLite has one writer, so this is bounded small on purpose.
MAP_WORKER_CONCURRENCY=3

# Lower than the local default (1800s/30min) so a hard-killed Worker's
# in-flight job is recovered faster after a restart -- see MA7.7A finding
# on lease-expiry recovery time. Tune per the actual Agent Run durations
# observed in staging.
MAP_DEFAULT_AGENT_RUN_TIMEOUT_SECONDS=900

# Set on the Railway *service* (not in this file) if the image's runtime
# user cannot write to the mounted volume -- see the "Volumes" section of
# docs/deployment/railway-staging.md.
# RAILWAY_RUN_UID=0

# Set on the Railway *service* (not in this file) to extend how long a
# graceful shutdown is given before SIGKILL -- scripts/hosted_entrypoint.py
# forwards SIGTERM to both the Worker and Web processes and waits up to
# its own internal grace period, which should stay comfortably under this.
# RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30

# ---------------------------------------------------------------------------
# Provider credentials -- never set as an env var. An OpenRouter API key
# is entered through the running application's own API/console
# (POST /providers, or scripts/provision_staging.py) once the service is
# up, and is stored via app.secrets_store (EncryptedFileSecretStore in
# hosted mode), never read from the process environment.
# ---------------------------------------------------------------------------
